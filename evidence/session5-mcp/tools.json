      "description": "Submit one locally proposed v1 testnet autoRepay() or reconcile its original hash. Requires explicit operator signer enablement.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "proposalId": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{64}$"
          }
        },
        "required": [
          "proposalId"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": true,
        "openWorldHint": true
      }
    },
    {
      "name": "sentinel_quote",
      "description": "Request an informational OKX OnchainOS WOKB/native USDC mainnet quote. Returns unavailable when credentials or service are missing.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "enum": [
              "WOKB",
              "USDC"
            ]
          },
          "amountRaw": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,77}$"
          }
        },
        "required": [
          "from",
          "amountRaw"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      }
